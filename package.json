{
  "name": "hafifa",
  "private": true,
  "description": "Training app for new recruits in the fullstack department",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run build -w packages/shared",
    "start": "concurrently -n site,api -c blue,green \"npm run start -w apps/site\" \"npm run start -w apps/api\"",
    "start:site": "npm run start -w apps/site",
    "start:api": "npm run start -w apps/api",
    "seed": "npm run seed -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0"
  }
}
